{
  "rewrites": [
    {
      "source": "/halla-crm-cloude/:path*",
      "destination": "/halla-crm-cloude/index.html"
    },
    {
      "source": "/ruedio",
      "destination": "/ruedio/index.html"
    },
    {
      "source": "/ruedio/",
      "destination": "/ruedio/index.html"
    },
    {
      "source": "/ruedio/:path*",
      "destination": "/ruedio/index.html"
    },
    {
      "source": "/((?!halla-crm-cloude|ruedio).*)",
      "destination": "/index.html"
    }
  ]
}
