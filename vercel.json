    {
      "source": "/halla-crm-cloude/:path*",
      "destination": "/halla-crm-cloude/index.html"
    },
    {
      "source": "/ruedio/app",
      "destination": "/ruedio/app/index.html"
    },
    {
      "source": "/ruedio/app/",
      "destination": "/ruedio/app/index.html"
    },
    {
      "source": "/ruedio/app/:path*",
      "destination": "/ruedio/app/index.html"
    },
    {
      "source": "/ruedio-task/app",
      "destination": "/ruedio-task/app/index.html"
    },
    {
      "source": "/ruedio-task/app/",
      "destination": "/ruedio-task/app/index.html"
    },
    {
      "source": "/ruedio-task/app/:path*",
      "destination": "/ruedio-task/app/index.html"
    },
    {
      "source": "/((?!halla-crm-cloude).*)",
      "destination": "/index.html"
    }
  ]
